<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mail_canned_response_view_tree_inherit_rich_text" model="ir.ui.view">
            <field name="name">mail.canned.response.list.inherit.rich.text</field>
            <field name="model">mail.canned.response</field>
            <field name="inherit_id" ref="mail.mail_canned_response_view_tree"/>
            <field name="arch" type="xml">
                <!-- Remove editable attribute so clicking opens the form view with the rich text editor -->
                <xpath expr="//list" position="attributes">
                    <attribute name="editable"></attribute>
                </xpath>
                <xpath expr="//field[@name='source']" position="after">
                    <field name="usage_type" readonly="not is_editable"/>
                </xpath>
            </field>
        </record>

        <record id="mail_canned_response_view_form_inherit_rich_text" model="ir.ui.view">
            <field name="name">mail.canned.response.form.inherit.rich.text</field>
            <field name="model">mail.canned.response</field>
            <field name="inherit_id" ref="mail.mail_canned_response_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='source']" position="after">
                    <field name="usage_type" readonly="not is_editable" widget="radio" options="{'horizontal': true}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
